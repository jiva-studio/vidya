{
	http_port 8080
	https_port 8443
}

{$VIDYA_GATEWAY_SITE_ADDRESS} {
	rate_limit {
		zone gateway_burst {
			key {remote_host}
			events {$VIDYA_GATEWAY_RATE_LIMIT_BURST}
			window 1s
		}
		zone gateway_sustained {
			key {remote_host}
			events {$VIDYA_GATEWAY_RATE_LIMIT_SUSTAINED_EVENTS}
			window 5s
		}
	}

	# Forward /api/* to the backend API service (prefix stripped)
	handle_path /api/* {
		reverse_proxy {$VIDYA_GATEWAY_API_UPSTREAM}
	}

	# Forward all other requests to the frontend Admin UI service
	handle {
		reverse_proxy {$VIDYA_GATEWAY_ADMIN_UPSTREAM}
		{$VIDYA_GATEWAY_HSTS_DIRECTIVE}
		header X-Frame-Options "DENY"
		header Content-Security-Policy "frame-ancestors 'none'"
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "no-referrer"
	}
}
