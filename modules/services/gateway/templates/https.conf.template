# TLS termination (VIDYA_GATEWAY_TLS_ENABLED=true). Plain HTTP on 8080 exists
# only to redirect to HTTPS; everything else is served from 8443.
#
# The certificate itself is not this file's concern and not decided in this
# repository — see README.md, "TLS certificates", for what a deployment must
# supply at VIDYA_GATEWAY_TLS_CERT / VIDYA_GATEWAY_TLS_KEY.

limit_req_zone $binary_remote_addr zone=vidya_gateway:10m rate=${VIDYA_GATEWAY_RATE_LIMIT_RPS}r/s;

server {
  listen 8080;
  server_name ${VIDYA_GATEWAY_SERVER_NAME};
  return 301 https://$host$request_uri;
}

server {
  listen 8443 ssl;
  http2 on;
  server_name ${VIDYA_GATEWAY_SERVER_NAME};

  ssl_certificate ${VIDYA_GATEWAY_TLS_CERT};
  ssl_certificate_key ${VIDYA_GATEWAY_TLS_KEY};
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  include /etc/nginx/includes/locations.conf;
}
