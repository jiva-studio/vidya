{{!--
  =============================================================================
  VIDYA TRANSACTIONAL EMAIL TEMPLATE — ONE-TIME PASSWORD (OTP)
  =============================================================================
  
  DESIGN SYSTEM COLOR PALETTE (Easily customizable):
  - Primary Brand Accent:     #0f766e (Teal-700)
  - Primary Hover / Deep:     #115e59 (Teal-800)
  - Accent Surface (Badge):   #f0fdfa (Teal-50)
  - Accent Border:            #ccfbf1 (Teal-100) / #99f6e4 (Teal-200)
  - Page Background:          #f8fafc (Slate-50)
  - Card Surface:             #ffffff (White)
  - Card Border:              #e2e8f0 (Slate-200)
  - Text Primary:             #0f172a (Slate-900)
  - Text Secondary / Body:    #475569 (Slate-600)
  - Text Muted / Footnote:    #94a3b8 (Slate-400)
  - Alert Box Surface:        #f1f5f9 (Slate-100)
  - Alert Box Border:         #e2e8f0 (Slate-200)

  TEMPLATE VARIABLES:
  - {{code}}                  The one-time password code (required, no whitespace)
  - {{brandName}}             Brand name (optional, defaults to "Vidya")
  - {{ttlMinutes}}            Validity window in minutes (optional, defaults to 5)
  - {{supportEmail}}          Support contact address (optional, defaults to "support@vidya.dev")
  - {{currentYear}}           Current year for copyright (optional, defaults to "2026")
  =============================================================================
--}}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en" xml:lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <title>Verification Code - {{#if brandName}}{{brandName}}{{else}}Vidya{{/if}}</title>
    
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->

    <style type="text/css">
      /* Client-specific resets */
      #outlook a { padding: 0; }
      body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
      
      /* Global Resets */
      body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        height: 100% !important;
        background-color: #f8fafc;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Responsive rules */
      @media only screen and (max-width: 600px) {
        .email-container {
          width: 100% !important;
          max-width: 100% !important;
        }
        .email-card {
          padding: 28px 20px 32px 20px !important;
          border-radius: 12px !important;
        }
        .otp-box {
          padding: 14px 16px !important;
        }
        .otp-code {
          letter-spacing: 3px !important;
          font-size: 26px !important;
        }
        .header-logo {
          font-size: 20px !important;
        }
      }

      /* Dark mode support */
      @media (prefers-color-scheme: dark) {
        body, .body-bg {
          background-color: #0b0f19 !important;
        }
        .email-card {
          background-color: #151d2f !important;
          border-color: #243048 !important;
        }
        .text-primary {
          color: #f1f5f9 !important;
        }
        .text-secondary {
          color: #94a3b8 !important;
        }
        .text-muted {
          color: #64748b !important;
        }
        .otp-box {
          background-color: #062a28 !important;
          border-color: #0f766e !important;
        }
        .otp-code {
          color: #2dd4bf !important;
        }
        .info-card {
          background-color: #1e293b !important;
          border-color: #334155 !important;
        }
        .info-text {
          color: #94a3b8 !important;
        }
        .footer-divider {
          border-color: #243048 !important;
        }
      }
    </style>
  </head>
  <body class="body-bg" style="margin: 0; padding: 0; background-color: #f8fafc; font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    
    <!-- Hidden Preheader / Preview Text (Prevents inbox snippet spillover) -->
    <div style="display: none; font-size: 1px; color: #f8fafc; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all;">
      Your {{#if brandName}}{{brandName}}{{else}}Vidya{{/if}} verification code is {{code}}. Valid for {{#if ttlMinutes}}{{ttlMinutes}}{{else}}5{{/if}} minutes.
      &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
    </div>

    <!-- Outer Wrapper Table -->
    <table role="presentation" class="body-bg" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; width: 100%; border-collapse: collapse; margin: 0; padding: 0;">
      <tr>
        <td align="center" style="padding: 40px 16px 48px 16px;">
          
          <!-- Inner Email Container (Max 580px) -->
          <table role="presentation" class="email-container" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 580px; width: 100%; margin: 0 auto; border-collapse: collapse;">
            
            <!-- Brand Header -->
            <tr>
              <td align="center" style="padding: 0 0 28px 0;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" style="vertical-align: middle;">
                      <!-- Brand Mark / Icon Badge -->
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse: separate;">
                        <tr>
                          <td style="background-color: #0f766e; width: 36px; height: 36px; border-radius: 10px; text-align: center; vertical-align: middle;">
                            <span style="color: #ffffff; font-size: 18px; font-weight: 700; line-height: 36px; display: inline-block; font-family: 'IBM Plex Sans', -apple-system, sans-serif;">✦</span>
                          </td>
                          <td style="padding-left: 12px; vertical-align: middle;">
                            <span class="header-logo text-primary" style="font-size: 22px; font-weight: 700; color: #0f172a; letter-spacing: -0.5px; font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                              {{#if brandName}}{{brandName}}{{else}}Vidya{{/if}}
                            </span>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Main White Card -->
            <tr>
              <td>
                <table role="presentation" class="email-card" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 40px 36px 44px 36px; box-shadow: 0 2px 8px -2px rgba(15, 23, 42, 0.06);">
                  
                  <!-- Title -->
                  <tr>
                    <td align="center" style="padding-bottom: 12px;">
                      <h1 class="text-primary" style="margin: 0; font-size: 22px; font-weight: 600; line-height: 1.3; color: #0f172a; font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                        Verification Code
                      </h1>
                    </td>
                  </tr>

                  <!-- Description -->
                  <tr>
                    <td align="center" style="padding-bottom: 28px;">
                      <p class="text-secondary" style="margin: 0; font-size: 15px; line-height: 1.55; color: #475569; max-width: 440px; font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                        Please use the one-time verification code below to complete your sign-in. This code is valid for 
                        <strong class="text-primary" style="color: #0f172a; font-weight: 600;">{{#if ttlMinutes}}{{ttlMinutes}}{{else}}5{{/if}} minutes</strong>.
                      </p>
                    </td>
                  </tr>

                  <!-- OTP Code Box -->
                  <tr>
                    <td align="center" style="padding-bottom: 28px;">
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 auto;">
                        <tr>
                          <td class="otp-box" align="center" style="background-color: #f0fdfa; border: 1.5px dashed #0f766e; border-radius: 12px; padding: 16px 28px; text-align: center;"><span class="otp-code" style="color: #0f766e; font-family: 'IBM Plex Mono', 'SF Mono', Consolas, Monaco, 'Courier New', monospace; font-size: 32px; font-weight: 700; letter-spacing: 4px; line-height: 1; user-select: all; -webkit-user-select: all; display: inline-block;">{{code}}</span></td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <!-- Security Advisory Card -->
                  <tr>
                    <td>
                      <table role="presentation" class="info-card" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px 20px;">
                        <tr>
                          <td style="vertical-align: top; width: 24px; padding-top: 2px;">
                            <span style="font-size: 16px; line-height: 1;">🔒</span>
                          </td>
                          <td style="padding-left: 10px; vertical-align: middle;">
                            <p class="info-text text-secondary" style="margin: 0; font-size: 13px; line-height: 1.5; color: #64748b; font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                              <strong>Do not share this code</strong> with anyone. Our team will never ask for your verification code. If you did not request this code, you can safely ignore this email.
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="padding: 28px 16px 0 16px;">
                <p class="text-muted" style="margin: 0 0 10px 0; font-size: 13px; line-height: 1.5; color: #64748b; font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                  Need help? Contact us at 
                  <a href="mailto:{{#if supportEmail}}{{supportEmail}}{{else}}support@vidya.dev{{/if}}" style="color: #0f766e; text-decoration: none; font-weight: 500;">
                    {{#if supportEmail}}{{supportEmail}}{{else}}support@vidya.dev{{/if}}
                  </a>
                </p>
                <p class="text-muted" style="margin: 0; font-size: 12px; line-height: 1.5; color: #94a3b8; font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                  © {{#if currentYear}}{{currentYear}}{{else}}2026{{/if}} {{#if brandName}}{{brandName}}{{else}}Vidya{{/if}}. All rights reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>

  </body>
</html>
