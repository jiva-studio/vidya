{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "inPlace": true,
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "../../../.stryker/incremental/api.json",
  "mutate": [
    "src/**/*.ts",
    "!src/**/specs/**",
    "!src/**/*.spec.ts",
    "!src/**/*.dto.ts",
    "!src/**/*.entity.ts",
    "!src/**/*.interface.ts",
    "!src/main.ts",
    "!src/**/*.module.ts",
    "!src/**/index.ts",
    "!src/shared/datasources/**",
    "!src/edu/shared/testing-app.ts"
  ],
  "reporters": ["clear-text", "progress"],
  "clearTextReporter": {
    "maxTestsToLog": 0
  },
  "timeoutMS": 5000,
  "timeoutFactor": 1.5,
  "dryRunTimeoutMinutes": 5,
  "disableBail": false,
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 50
  },
  "concurrency": 8
}
