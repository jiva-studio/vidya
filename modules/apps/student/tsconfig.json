{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@vidya/client": ["../../libs/client"],
      "@vidya/client/testing": ["../../libs/client/testing"],
      "@vidya/domain": ["../../libs/domain"],
      "@vidya/protocol": ["../../libs/protocol"],
      "@vidya/usecases": ["../../libs/usecases"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
