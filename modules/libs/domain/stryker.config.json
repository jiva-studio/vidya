{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "inPlace": true,
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "../../../.stryker/incremental/domain.json",
  "mutate": [
    "*.ts",
    "permissions/**/*.ts",
    "ports/**/*.ts",
    "sync/**/*.ts",
    "!__tests__/**",
    "!**/*.spec.ts",
    "!index.ts"
  ],
  "reporters": ["clear-text", "progress"],
  "clearTextReporter": {
    "maxTestsToLog": 0
  },
  "timeoutMS": 5000,
  "timeoutFactor": 1.5,
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 50
  },
  "concurrency": 8
}
