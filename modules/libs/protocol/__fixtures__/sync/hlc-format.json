      "physical": 1,
      "counter": 0,
      "deviceId": "d"
    },
    {
      "hlc": "001789689600000:00000:device-8f2a6c14",
      "physical": 1789689600000,
      "counter": 0,
      "deviceId": "device-8f2a6c14",
      "createdAt": "2026-09-18T00:00:00.000Z"
    },
    {
      "hlc": "001789689600000:99999:device-8f2a6c14",
      "physical": 1789689600000,
      "counter": 99999,
      "deviceId": "device-8f2a6c14",
      "createdAt": "2026-09-18T00:00:00.000Z"
    },
    {
      "hlc": "001789689600000:00007:a:b:c",
