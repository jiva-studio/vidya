{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "../../../.stryker/incremental/ui.json",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.stories.ts",
    "!src/**/index.ts",
    "!src/**/types.ts",
    "!src/**/styles.ts",
    "!src/index.ts"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "clearTextReporter": {
    "maxTestsToLog": 0
  },
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 15,
  "disableBail": false,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "concurrency": 8
}
