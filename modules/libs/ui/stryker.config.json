{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": { "command": "npx vitest run" },
  "coverageAnalysis": "off",
  "incremental": true,
  "incrementalFile": "../../../.stryker/incremental/ui.json",
  "mutate": [
    "src/**/*.ts",
    "!src/**/__tests__/**",
    "!src/**/*.spec.ts",
    "!src/**/*.stories.ts",
    "!src/**/index.ts",
    "!src/**/types.ts",
    "!src/**/styles.ts",
    "!src/main.ts",
    "!src/shared/testing/**"
  ],
  "reporters": ["clear-text", "progress"],
  "clearTextReporter": { "maxTestsToLog": 0 },
  "timeoutMS": 120000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 15,
  "concurrency": 4,
  "thresholds": { "high": 80, "low": 60, "break": 50 }
}
