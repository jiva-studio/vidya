{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": ".",
    "paths": {
      "@vidya/client": ["libs/client"],
      "@vidya/client/testing": ["libs/client/testing"],
      "@vidya/domain": ["libs/domain"],
      "@vidya/entities": ["libs/entities"],
      "@vidya/protocol": ["libs/protocol"],
      "@vidya/usecases": ["libs/usecases"],
      "@vidya/api/*": ["services/api/src/*"]
    }
  }
}
