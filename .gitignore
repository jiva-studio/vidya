node_modules
dist
coverage
*.tsbuildinfo
*.log
.env
.env.local
.claude/
plan.md

# Specs are per-branch working documents, written by /spec and finished when the
# branch merges. The template is the shared part and stays; the specs themselves
# would otherwise leave a permanent trail of transient planning in history.
.agents/specs/*
!.agents/specs/TEMPLATE.md

# Stryker's sandbox, HTML reports and incremental baseline. The baseline is
# local on purpose: it is reused between runs on one checkout, and `diff` mode —
# the only mode a branch has to pass — mutates exactly the files a baseline
# cannot hold, the ones the branch changed.
.stryker-tmp
.stryker/
modules/**/reports
stryker.log

# Plans are working documents and live in the project's own docs, not here.
docs/PLAN-*.md
