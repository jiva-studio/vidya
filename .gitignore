node_modules
dist
coverage
*.tsbuildinfo
*.log
.env
.env.local
.claude/
plan.md

# Specs are per-branch working documents, written by /spec and finished when the
# branch merges. The template is the shared part and stays; the specs themselves
# would otherwise leave a permanent trail of transient planning in history.
.agents/specs/*
!.agents/specs/TEMPLATE.md

# Stryker's sandbox and HTML reports. The incremental baseline under
# .stryker/incremental/ is committed on purpose: it is what a branch is
# measured against.
.stryker-tmp
modules/**/reports
stryker.log
