#!/bin/bash
set -euo pipefail

# npm workspace commands below resolve against modules/package.json, so the
# script works from any cwd rather than only from modules/.
MODULES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../modules" && pwd)"
cd "$MODULES_DIR"

# ---------------------------------------------------------------------------- #
#                                     Doc                                      #
# ---------------------------------------------------------------------------- #

echo "
# ---------------------------------------------- #
#               Creating Migration               #
# ---------------------------------------------- #

Enter the name of the migration you want to create.
Please use snake_case for the migration name.
Example: migration_example
"


# ---------------------------------------------------------------------------- #
#                                     Task                                     #
# ---------------------------------------------------------------------------- #

echo "Migration Name: "
read name
npx --workspace @vidya/database typeorm migration:generate ./migrations/$name -d ./main.ts
