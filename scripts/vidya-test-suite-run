#!/usr/bin/env bash
set -euo pipefail

# Runs the test suites, against one of three backends.
#
#   memory              every suite, backed by pg-mem. The default, and what
#                       `make test` and CI's main job run. Needs nothing
#                       installed and finishes in about a minute.
#
#   postgres-required   only the suites a real database is required for — the
#                       ones named `*.postgres.spec.ts`. pg-mem has a single
#                       session and stubs advisory locking out, so properties
#                       like "two processes cannot apply the same migration at
#                       once" cannot be tested there at all: under pg-mem these
#                       suites skip themselves and prove nothing. This is the
#                       postgres target that belongs in the mandatory gate.
#
#   postgres            every suite, with a real Postgres swapped in for pg-mem.
#                       Broader, slower, and run by hand or on a schedule rather
#                       than per change.
#
#   storage-required    only the suites a real S3 is required for — the ones
#                       named `*.storage.spec.ts`. A fake port cannot answer
#                       whether a signed Content-Length is honoured, whether a
#                       range request comes back as 206, or whether a POST
#                       policy exists at all: those are properties of the
#                       provider, not of our code, and every provider answers
#                       differently. `make dev-up` brings up the MinIO these
#                       suites run against.
#
# Without a reachable server the two postgres modes stop immediately and say so.
# `storage-required` does the same for S3. They do not fall back: a silent
# fallback reports a pass for suites that never ran, which is worse than a
# failure.
#
# S3 settings come from VIDYA_MEDIA_DEFAULT_ENDPOINT / _ACCESS_KEY_ID /
# _SECRET / _BUCKET, defaulting to the stand's MinIO on 7804.
#
# Connection settings come from VIDYA_TEST_DB_HOST / _PORT / _USERNAME /
# _PASSWORD. The database name is derived from the checkout so that worktrees
# sharing one server do not overwrite each other's schema; see
# `services/api/src/shared/datasources/testing.datasource.ts`.

usage() {
  echo "usage: $(basename "$0") [memory|postgres|postgres-required|storage-required]" >&2
  exit 2
}

MODE="${1:-memory}"
shift || true

MODULES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../modules" && pwd)"
cd "$MODULES_DIR"

require_storage() {
  local endpoint="${VIDYA_MEDIA_DEFAULT_ENDPOINT:-http://127.0.0.1:7804}"

  # A plain HTTP probe, so the check needs no S3 client. MinIO answers
  # /minio/health/live; an unauthenticated request to the root of an S3 API
  # answers 403, which still proves something is listening and speaking HTTP.
  if ! VIDYA_S3_ENDPOINT="$endpoint" node -e '
    const url = new URL(process.env.VIDYA_S3_ENDPOINT)
    const http = require(url.protocol === "https:" ? "https" : "http")
    const request = http.get(new URL("/minio/health/live", url), (response) => {
      response.resume()
      process.exit(response.statusCode && response.statusCode < 500 ? 0 : 1)
    })
    request.setTimeout(3000, () => { request.destroy(); process.exit(1) })
    request.on("error", () => process.exit(1))
  '; then
    echo "No S3 at ${endpoint}." >&2
    echo "Start the stand with 'make dev-up', or point VIDYA_MEDIA_DEFAULT_ENDPOINT at a server." >&2
    exit 1
  fi
}

require_server() {
  local host="${VIDYA_TEST_DB_HOST:-127.0.0.1}"
  local port="${VIDYA_TEST_DB_PORT:-5432}"

  # A plain TCP connect, so the check needs neither psql nor a driver.
  if ! VIDYA_PG_HOST="$host" VIDYA_PG_PORT="$port" node -e '
    const net = require("net")
    const socket = net.connect(
      { host: process.env.VIDYA_PG_HOST, port: Number(process.env.VIDYA_PG_PORT) },
      () => { socket.destroy(); process.exit(0) },
    )
    socket.setTimeout(3000)
    socket.on("timeout", () => { socket.destroy(); process.exit(1) })
    socket.on("error", () => process.exit(1))
  '; then
    echo "No Postgres at ${host}:${port}." >&2
    echo "Start one with 'make db-start', or point VIDYA_TEST_DB_HOST/_PORT at a server." >&2
    exit 1
  fi
}

case "$MODE" in
  memory)
    npm run test --workspaces --if-present
    ;;
  postgres)
    require_server
    VIDYA_TEST_DB=postgres npm run test --workspaces --if-present
    ;;
  postgres-required)
    require_server

    # Only @vidya/api talks to a database, so only its suites can need one.
    #
    # The set is found, not maintained. A suite needs a real database either by
    # being named for one or by holding a block behind `describeOnPostgres` —
    # and the second kind lives inside ordinary `*.e2e.spec.ts` files, which a
    # fixed name pattern walks straight past. It walked past the atomicity of
    # the enrolment cascade for exactly that reason. Grepping for the marker
    # means a new gated block joins the gate by existing rather than by someone
    # remembering to widen a pattern here.
    GATED="$(
      cd "$MODULES_DIR/services/api" \
        && grep -rlE '(describe|it)OnPostgres' src \
        | sort -u \
        | sed 's/\./\\./g' \
        | paste -sd'|' -
    )"

    if [ -z "$GATED" ]; then
      echo "No postgres-gated suite found. Either the marker was renamed or the" >&2
      echo "grep above is wrong; refusing to report a pass for suites never run." >&2
      exit 1
    fi

    VIDYA_TEST_DB=postgres npm run test -w @vidya/api -- \
      --testPathPattern "\.postgres\.spec\.ts$|($GATED)$"
    ;;
  storage-required)
    require_storage

    # Named for it, and only that: unlike the postgres marker there is no
    # in-file gate to grep for, because a suite that talks to storage cannot
    # keep a half of itself runnable without one.
    HAS_SUITE="$(cd "$MODULES_DIR/services/api" && find src -name '*.storage.spec.ts' | head -n 1)"

    if [ -z "$HAS_SUITE" ]; then
      echo "No *.storage.spec.ts found; refusing to report a pass for a set that is empty." >&2
      exit 1
    fi

    # The package config ignores these suites so the default run stays green
    # without a provider; this is the one caller that wants them.
    npm run test -w @vidya/api -- \
      --testPathPattern '\.storage\.spec\.ts$' \
      --testPathIgnorePatterns '/node_modules/' \
      --runInBand
    ;;
  *)
    usage
    ;;
esac
