#!/usr/bin/env bash
set -euo pipefail

# Runs a command with exclusive claim on the machine: one such run at a time
# across every worktree, and none at all on a machine already busy. The full
# gate and mutation testing go through it.
#
# Every worktree of this repository shares one machine and nothing in a checkout
# reports what another checkout is doing, so the lock lives in the common git
# directory, which all of them see, and records who took it. Under a load
# average several times the core count these runs stop converging: jest's 60
# second timeout fires and the report fills with `Exceeded timeout for a hook`,
# which reads as a defect and is only contention.
#
# VIDYA_RUN_ANYWAY=1 skips both checks. CI skips the load one: a build machine
# is meant to be busy and is the only one running.

usage() {
  echo "usage: $(basename "$0") <label> <command> [args...]" >&2
  exit 2
}

LABEL="${1:-}"
[ -z "$LABEL" ] && usage
shift
[ "$#" -eq 0 ] && usage

if [ "${VIDYA_RUN_ANYWAY:-}" = "1" ]; then
  exec "$@"
fi

COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo .git)"
case "$COMMON_DIR" in
  /*) ;;
  *) COMMON_DIR="$(cd "$COMMON_DIR" && pwd)" ;;
esac

LOCK="$COMMON_DIR/vidya-exclusive.lock"

# One-minute load average, read where each platform keeps it.
load_now() {
  if [ -r /proc/loadavg ]; then
    cut -d' ' -f1 </proc/loadavg
  elif command -v sysctl >/dev/null 2>&1; then
    sysctl -n vm.loadavg 2>/dev/null | tr -d '{}' | awk '{print $1}'
  else
    echo 0
  fi
}

cores() {
  if command -v nproc >/dev/null 2>&1; then
    nproc
  elif command -v sysctl >/dev/null 2>&1; then
    sysctl -n hw.ncpu 2>/dev/null || echo 1
  else
    echo 1
  fi
}

# A lock whose holder is gone is not a lock. mkdir is the atomic step; the pid
# inside it is what makes a crashed run recoverable without a flag to clear it.
take_lock() {
  if mkdir "$LOCK" 2>/dev/null; then
    printf '%s\n%s\n%s\n' "$$" "$LABEL" "$PWD" >"$LOCK/holder"
    return 0
  fi

  local pid
  pid="$(head -n 1 "$LOCK/holder" 2>/dev/null || echo)"

  if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
    rm -rf "$LOCK"
    take_lock
    return
  fi

  return 1
}

if ! take_lock; then
  holder_label="$(sed -n 2p "$LOCK/holder" 2>/dev/null || echo 'a heavy run')"
  holder_dir="$(sed -n 3p "$LOCK/holder" 2>/dev/null || echo 'another worktree')"

  echo "Refusing to start: ${holder_label} is already running in ${holder_dir}." >&2
  echo "Two of these on one machine make each other time out. Wait for it, or" >&2
  echo "run your own narrow suite instead:" >&2
  echo "  npm --prefix modules run test -w <pkg> -- --testPathPattern '<yours>' --runInBand" >&2
  exit 1
fi

trap 'rm -rf "$LOCK"' EXIT INT TERM

if [ "${CI:-}" != "true" ]; then
  LOAD="$(load_now)"
  CORES="$(cores)"
  CEILING="$(awk -v c="$CORES" 'BEGIN { printf "%.0f", c * 1.5 }')"

  if awk -v l="$LOAD" -v ceiling="$CEILING" 'BEGIN { exit !(l > ceiling) }'; then
    echo "Refusing to start ${LABEL}: load average is ${LOAD} on ${CORES} cores." >&2
    echo "Above ${CEILING} the suites time out at 60s and report defects that are" >&2
    echo "only load. Wait for the machine, or set VIDYA_RUN_ANYWAY=1 to insist." >&2
    exit 1
  fi
fi

"$@"
