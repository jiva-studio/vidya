#!/usr/bin/env bash
set -euo pipefail

# Mutation testing: change the code on purpose and see whether the suite notices.
#
#   diff <package>   mutate only the source files this branch changed, measured
#                    against the merge base with main. This is the per-change
#                    run, and what a band has to pass before handing over.
#
#   full <package>   mutate the whole package. Slow — hours, for a package the
#                    size of the API — so it belongs on a schedule or a manual
#                    run, not in the gate.
#
# Both modes read the package's stryker.config.json and both run incrementally:
# results carry over in .stryker/incremental/, which is local and untracked, so
# a second run on the same checkout re-measures only what changed since the
# first. A file whose mutants are all restored is not re-run — which is what
# makes `full` bearable and does nothing for `diff`, whose whole input is the
# files the branch changed.
#
# Coverage tells you a line executed. This tells you the suite would have
# complained if the line were wrong, which is the thing coverage never proves.
#
# Two ways a run can be worth nothing, and both end the same way — the script
# says SKIPPED, exits 0, and the caller reports the gap instead of waiting:
#
#   * the package is listed in UNUSABLE below, because its mutants time out
#     faster than they are killed;
#   * the run exceeds VIDYA_MUTATION_BUDGET.
#
# A score nobody waited eleven hours for is not evidence, and neither is a
# number produced by two thirds of the mutants timing out.

# Packages whose mutation runs cannot be trusted today, with the issue that
# says why. Listed here rather than remembered, because the cost of forgetting
# is an agent waiting hours for a number it cannot use.
UNUSABLE_PACKAGES="@vidya/api:20"

# How long any run may take before it is abandoned. Override for a deliberate
# long run: VIDYA_MUTATION_BUDGET=4h make mutate-full PKG=...
BUDGET="${VIDYA_MUTATION_BUDGET:-45m}"

skipped() {
  echo "" >&2
  echo "SKIPPED: mutation testing did not produce a score for $PKG." >&2
  echo "  $1" >&2
  echo "  Report this as a gap in the handover; do not wait for it." >&2
  exit 0
}

usage() {
  echo "usage: $(basename "$0") <diff|full> <@vidya/package|all>" >&2
  exit 2
}

MODE="${1:-}"
PKG="${2:-}"
[ -n "$MODE" ] && [ -n "$PKG" ] || usage

# Before the workspace lookup on purpose: a refusal must not depend on
# node_modules being installed, and must cost nothing.
for entry in $UNUSABLE_PACKAGES; do
  if [ "${entry%%:*}" = "$PKG" ]; then
    skipped "Its mutants time out faster than they are killed — see issue #${entry##*:}."
  fi
done

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODULES_DIR="$REPO_ROOT/modules"

# Unset stand/fixture env vars exported by Makefile so unit tests run in pristine isolated mode
unset VIDYA_MEDIA_DEFAULT_ENDPOINT VIDYA_MEDIA_DEFAULT_BUCKET VIDYA_MEDIA_DEFAULT_ACCESS_KEY_ID VIDYA_MEDIA_DEFAULT_SECRET VIDYA_MEDIA_MASTER_KEY 2>/dev/null || true

run_for_package() {
  local package="$1"
  local location
  location="$(cd "$MODULES_DIR" && npm query ".workspace" | PKG="$package" node -e '
    let raw = ""
    process.stdin.on("data", (chunk) => (raw += chunk))
    process.stdin.on("end", () => {
      const match = JSON.parse(raw).find((w) => w.name === process.env.PKG)
      if (!match) {
        console.error(`unknown workspace: ${process.env.PKG}`)
        process.exit(1)
      }
      console.log(match.location)
    })
  ')"

  local pkg_dir="$MODULES_DIR/$location"

  if [ ! -f "$pkg_dir/stryker.config.json" ]; then
    echo "$package has no stryker.config.json — it is not under mutation testing." >&2
    echo "Add one next to its jest.config.js to bring it in." >&2
    return 1
  fi

  mkdir -p "$REPO_ROOT/.stryker/incremental"
  (
    cd "$pkg_dir"
    echo "=== Running mutation testing ($MODE) for $package ($location) ==="

    case "$MODE" in
      full)
        timeout "$BUDGET" npx stryker run && exit 0
        status=$?
        [ "$status" -eq 124 ] && skipped "It ran past the $BUDGET budget and was abandoned."
        exit "$status"
        ;;
      diff)
        local base
        base="$(git -C "$REPO_ROOT" merge-base HEAD origin/main 2>/dev/null || git -C "$REPO_ROOT" merge-base HEAD main)"

        local changed
        changed="$(
          {
            git -C "$REPO_ROOT" diff --name-only --diff-filter=d "$base...HEAD" -- "modules/$location"
            git -C "$REPO_ROOT" diff --name-only --diff-filter=d HEAD -- "modules/$location"
          } \
            | sort -u \
            | grep -E '\.ts$' \
            | grep -v -E '(/specs/|/__tests__/|/__fixtures__/|\.spec\.ts$|\.test\.ts$|\.stories\.ts$|/main\.ts$|\.module\.ts$|/index\.ts$|/testing\.ts$)' \
            | grep -v -E '(/types\.ts$|/styles\.ts$)' \
            | grep -v -E '(/shared/datasources/|/shared/testing-app\.ts$)' \
            | sed "s|^modules/$location/||" || true
        )"

        if [ -z "$changed" ]; then
          echo "$package: no mutatable source changed since $base. Nothing to measure."
          exit 0
        fi

        echo "$package: mutating $(echo "$changed" | wc -l) changed file(s) since $base"
        echo "$changed" | sed 's/^/  /'

        timeout "$BUDGET" npx stryker run --mutate "$(echo "$changed" | paste -sd, -)" && exit 0
        status=$?
        [ "$status" -eq 124 ] && skipped "It ran past the $BUDGET budget and was abandoned."
        exit "$status"
        ;;
      *)
        usage
        ;;
    esac
  )
}

case "$PKG" in
  all)
    echo "=== Finding all packages with Stryker configs in $MODULES_DIR ==="
    STATUS=0
    for config_file in "$MODULES_DIR"/*/*/stryker.config.json; do
      if [ -f "$config_file" ]; then
        pkg_dir="$(dirname "$config_file")"
        pkg_name="$(node -e "console.log(require('$pkg_dir/package.json').name)")"
        echo ""
        echo "================================================================================"
        echo "Package: $pkg_name"
        echo "================================================================================"
        if ! run_for_package "$pkg_name"; then
          STATUS=1
        fi
      fi
    done
    exit $STATUS
    ;;
  *)
    run_for_package "$PKG"
    ;;
esac
