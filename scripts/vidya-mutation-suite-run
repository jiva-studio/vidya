#!/usr/bin/env bash
set -euo pipefail

# Mutation testing: change the code on purpose and see whether the suite notices.
#
#   diff <package>   mutate only the source files this branch changed, measured
#                    against the merge base with main. This is the per-change
#                    run, and what a band has to pass before handing over.
#
#   full <package>   mutate the whole package. Slow — hours, for a package the
#                    size of the API — so it belongs on a schedule or a manual
#                    run, not in the gate.
#
# Both modes read the package's stryker.config.json and both run incrementally:
# results carry over in .stryker/incremental/, which is committed, so a branch
# is scored against the baseline main produced rather than starting from zero.
# A file whose mutants are all restored from the baseline is not re-run.
#
# Coverage tells you a line executed. This tells you the suite would have
# complained if the line were wrong, which is the thing coverage never proves.

usage() {
  echo "usage: $(basename "$0") <diff|full> <@vidya/package>" >&2
  exit 2
}

MODE="${1:-}"
PKG="${2:-}"
[ -n "$MODE" ] && [ -n "$PKG" ] || usage

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODULES_DIR="$REPO_ROOT/modules"

LOCATION="$(cd "$MODULES_DIR" && npm query ".workspace" | PKG="$PKG" node -e '
  let raw = ""
  process.stdin.on("data", (chunk) => (raw += chunk))
  process.stdin.on("end", () => {
    const match = JSON.parse(raw).find((w) => w.name === process.env.PKG)
    if (!match) {
      console.error(`unknown workspace: ${process.env.PKG}`)
      process.exit(1)
    }
    console.log(match.location)
  })
')"

PKG_DIR="$MODULES_DIR/$LOCATION"

if [ ! -f "$PKG_DIR/stryker.config.json" ]; then
  echo "$PKG has no stryker.config.json — it is not under mutation testing." >&2
  echo "Add one next to its jest.config.js to bring it in." >&2
  exit 1
fi

mkdir -p "$REPO_ROOT/.stryker/incremental"
cd "$PKG_DIR"

case "$MODE" in
  full)
    exec npx stryker run
    ;;
  diff)
    BASE="$(git -C "$REPO_ROOT" merge-base HEAD origin/main 2>/dev/null || git -C "$REPO_ROOT" merge-base HEAD main)"

    # Committed work plus whatever is still in the tree, so the run answers the
    # question before the last commit as well as after it. Stryker's own mutate
    # patterns do not apply to files named on the command line, so the same
    # exclusions — specs, modules, barrel files — are applied here instead.
    #
    # `.vue` is absent on purpose. Stryker instruments a component with local
    # counters, and Vue refuses a `defineProps` that reads a local, so a
    # component written the way this project writes them cannot be compiled once
    # it is instrumented.
    #
    # The front-end packages carry no config. The vitest runner does not drive
    # vitest 5 — it reports a fraction of a test per mutant and everything
    # survives — and the command runner, which does work, needs a command
    # naming the specs that cover the file: the whole suite fails inside the
    # sandbox. Until that is settled they are measured by hand, as §4.2 asks.
    CHANGED="$(
      {
        git -C "$REPO_ROOT" diff --name-only --diff-filter=d "$BASE...HEAD" -- "modules/$LOCATION/src"
        git -C "$REPO_ROOT" diff --name-only --diff-filter=d HEAD -- "modules/$LOCATION/src"
      } \
        | sort -u \
        | grep -E '\.ts$' \
        | grep -v -E '(/specs/|\.spec\.ts$|\.stories\.ts$|/main\.ts$|\.module\.ts$|/index\.ts$)' \
        | grep -v -E '(/types\.ts$|/styles\.ts$)' \
        | grep -v -E '(/shared/datasources/|/shared/testing-app\.ts$)' \
        | sed "s|^modules/$LOCATION/||" || true
    )"

    if [ -z "$CHANGED" ]; then
      echo "$PKG: no mutatable source changed since $BASE. Nothing to measure."
      exit 0
    fi

    echo "$PKG: mutating $(echo "$CHANGED" | wc -l) changed file(s) since $BASE"
    echo "$CHANGED" | sed 's/^/  /'

    exec npx stryker run --mutate "$(echo "$CHANGED" | paste -sd, -)"
    ;;
  *)
    usage
    ;;
esac
