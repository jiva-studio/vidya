#!/usr/bin/env bash
set -euo pipefail

# Drops every Postgres database the test suite has ever created on this server.
#
# The suite names its database after the checkout it runs from, so each worktree
# reuses one database instead of leaving a new one behind per run. What this
# cleans up is the other half: databases belonging to worktrees that have since
# been deleted, which nothing else will ever reclaim.
#
# Safe to run at any time. The next suite recreates what it needs.
#
# Matches `^vidya_test` by default. Pass a POSIX regex to reach databases from
# before that naming, e.g. `vidya-db-testdb-drop '^vidya_(journal|srvfix)'`.

PATTERN="${1:-^vidya_test}"

MODULES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../modules" && pwd)"
cd "$MODULES_DIR"

VIDYA_TESTDB_PATTERN="$PATTERN" node -e '
  const { Client } = require("pg")

  const admin = new Client({
    host: process.env.VIDYA_TEST_DB_HOST || "127.0.0.1",
    port: Number(process.env.VIDYA_TEST_DB_PORT || 5432),
    user: process.env.VIDYA_TEST_DB_USERNAME || "postgres",
    password: process.env.VIDYA_TEST_DB_PASSWORD || "postgres",
    database: "postgres",
  })

  ;(async () => {
    await admin.connect()
    try {
      const { rows } = await admin.query(
        "SELECT datname FROM pg_database WHERE datname ~ $1 ORDER BY datname",
        [process.env.VIDYA_TESTDB_PATTERN],
      )

      if (rows.length === 0) {
        console.log(`No database matches ${process.env.VIDYA_TESTDB_PATTERN}.`)
        return
      }

      for (const { datname } of rows) {
        // DROP DATABASE takes an identifier, not a value, and the names here
        // came from pg_database rather than from user input.
        await admin.query(`DROP DATABASE IF EXISTS "${datname}" WITH (FORCE)`)
        console.log(`Dropped ${datname}`)
      }
    } finally {
      await admin.end()
    }
  })().catch((error) => {
    console.error(error.message)
    process.exit(1)
  })
'
